DATABASE_URL="postgresql://postgres:postgres@localhost:5432/politics_tracker"
PORT=3000

# ==============================================================================
# CONFIGURAÇÃO DE CORS (Cross-Origin Resource Sharing)
# ==============================================================================
# Especifique as URLs permitidas separadas por vírgula.
# Aceita:
#  - Domínios exatos: https://meu-app.vercel.app,http://localhost:3000
#  - Curingas: https://*.vercel.app,*.meudominio.com.br
#  - Wildcard total: * (permite qualquer origem com reflexão dinâmica e suporte a credenciais)
#
# Em produção (deploy), configure a URL da sua aplicação Web frontend (ex: Vercel):
# CORS_ORIGIN="http://localhost:3000,https://*.vercel.app,https://meu-projeto.vercel.app"
CORS_ORIGIN="*"
