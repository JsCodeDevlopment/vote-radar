# URL da API NestJS
# No ambiente local: http://localhost:3000
# Em produção (deploy): URL da API hospedada (ex: https://politica-tracker-api.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:3000

# auto  = tenta a API; se ela nao responder, usa dados de demonstracao
# api   = somente API real
# mock  = somente dados de demonstracao
NEXT_PUBLIC_DATA_MODE=auto
